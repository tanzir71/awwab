  "simDialogue": [
    { "ar": "السلام عليكم، أبغى شريحة لو سمحت.", "tr": "as-salāmu ʿalaykum, abgha sharīḥa law samaḥt.", "meaning": ["Peace be upon you. I’d like a SIM card, please.", "আপনার ওপর শান্তি বর্ষিত হোক। দয়া করে একটি সিম কার্ড দিন।"] },
    { "ar": "وعليكم السلام. تبغى باقة إنترنت؟", "tr": "wa ʿalaykum as-salām. tabgha bāgat internet?", "meaning": ["And peace be upon you. Do you want an internet package?", "আপনার ওপরও শান্তি বর্ষিত হোক। ইন্টারনেট প্যাকেজ চান?"] },
    { "ar": "إيوه، كم سعرها؟", "tr": "aywa, kam siʿrha?", "meaning": ["Yes. How much is it?", "হ্যাঁ। এর দাম কত?"] },
    { "ar": "بخمسين ريال. أبغى جوازك.", "tr": "bi-khamsīn riyāl. abgha jawāzak.", "meaning": ["Fifty riyals. I need your passport.", "পঞ্চাশ রিয়াল। আপনার পাসপোর্ট লাগবে।"] }
  ],
