        { "name": ["Open space of the mouth and throat", "মুখ ও গলার খোলা অংশ"], "letters": "ا و ي" }
      ],
      "makhraj-throat": [
        { "name": ["Deep throat", "গলার গভীর অংশ"], "letters": "ء ه" },
        { "name": ["Middle of the throat", "গলার মাঝের অংশ"], "letters": "ع ح" },
        { "name": ["Throat nearest the mouth", "মুখের কাছের গলা"], "letters": "غ خ" }
      ],
      "makhraj-tongue": [
        { "name": ["Farthest back of the tongue against the palate", "জিহ্বার সবচেয়ে পেছনের অংশ তালুতে"], "letters": "ق" },
        { "name": ["Back of the tongue, slightly farther forward", "জিহ্বার পেছনের অংশ, একটু সামনে"], "letters": "ك" },
        { "name": ["Middle of the tongue against the palate", "জিহ্বার মাঝের অংশ তালুতে"], "letters": "ج ش ي" },
        { "name": ["Side of the tongue against the upper molars", "জিহ্বার পাশ ওপরের পেছনের দাঁতে"], "letters": "ض" },
        { "name": ["Front edge and tip of the tongue at the upper gums", "জিহ্বার সামনের ধার ও ডগা ওপরের মাড়িতে"], "letters": "ل" },
        { "name": ["Tip of the tongue at the upper gums", "জিহ্বার ডগা ওপরের মাড়িতে"], "letters": "ن" },
        { "name": ["Tip and upper surface of the tongue at the upper gums", "জিহ্বার ডগা ও ওপরের অংশ ওপরের মাড়িতে"], "letters": "ر" },
        { "name": ["Tip of the tongue at the roots of the upper front teeth", "জিহ্বার ডগা ওপরের সামনের দাঁতের গোড়ায়"], "letters": "ط د ت" },
        { "name": ["Tip of the tongue near the lower front teeth", "জিহ্বার ডগা নিচের সামনের দাঁতের কাছে"], "letters": "ص ز س" },
        { "name": ["Tip of the tongue at the edges of the upper front teeth", "জিহ্বার ডগা ওপরের সামনের দাঁতের কিনারায়"], "letters": "ظ ذ ث" }
      ],
      "makhraj-lips": [
        { "name": ["Inside of the lower lip at the upper front teeth", "নিচের ঠোঁটের ভেতরের অংশ ওপরের সামনের দাঁতে"], "letters": "ف" },
        { "name": ["The two lips, closed or rounded depending on the letter", "হরফ অনুযায়ী দুই ঠোঁট বন্ধ বা গোল হয়"], "letters": "ب م و" }
      ],
      "makhraj-nose": [
        { "name": ["Nasal passage for ghunnah", "গুন্নাহর জন্য নাকের পথ"], "letters": "نّ مّ" }
      ]
    },
